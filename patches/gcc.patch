+/* Definitions for RISC-V 9front (Plan 9) systems, before plan9.h.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* riscv64 9front: the psABI (lp64d), the flags of the tree's build
+   (riscv64/cflags.json): configure --with-arch=rv64gc --with-abi=lp64d
+   --with-cmodel=medany.  */
+
+#define PLAN9_OBJTYPE "riscv64"
+
+/* No linker relaxation: nothing sets gp (__global_pointer$) for a
+   program -- neither 9front's _main nor the kernel, and jc's code uses
+   the register as its static base -- so gp-relative accesses are out;
+   the tree compiles -mno-relax and links --no-relax (which is enough
+   for assembly that has relaxable relocations).  An explicit -mrelax
+   wins (and needs a gp of its own).  */
+#define PLAN9_CC1_SPEC "%{!mrelax:-mno-relax}"
+#define PLAN9_LINK_SPEC " %{!mrelax:--no-relax}"
+
+/* char is signed, as with 9front's compilers (jc) and the tree's
+   -fsigned-char.  */
+#undef DEFAULT_SIGNED_CHAR
+#define DEFAULT_SIGNED_CHAR 1
