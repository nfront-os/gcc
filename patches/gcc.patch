+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#define PLAN9_OBJTYPE "386"
+
+/* 9front's 386 programs start with the stack only 4-byte aligned (the
+   kernel's initial stack, notes); the tree is compiled
+   -mincoming-stack-boundary=2 too (386/cflags.json).  Configure with
+   --with-arch=pentium as the tree's -march=pentium.  */
+#define PLAN9_CC1_SPEC \
+  "%{!mincoming-stack-boundary=*:-mincoming-stack-boundary=2}"
+
+/* intptr_t and uintptr_t as size_t and ptrdiff_t, long (gcc's default
+   SIZE_TYPE, not glibc-stdint.h's int for 32 bits): one type, as on
+   most systems (code passes a uintptr_t * for a size_t *), and as the
+   tree's <u.h> has uintptr.  The same size: no change of the ABI.  */
+#undef INTPTR_TYPE
+#define INTPTR_TYPE "long int"
+#undef UINTPTR_TYPE
+#define UINTPTR_TYPE "long unsigned int"
