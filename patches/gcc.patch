+
+/* The C libraries' _main (APE's main9.S, libc's) call main directly and
+   know nothing of .init_array.  The driver links with --wrap=main
+   (gcc/config/plan9.h), so they call __wrap_main, which runs the
+   constructors /$objtype/plan9.ld collected, then the program's main.
+   The symbols are weak: a linker script without them runs none.
+
+   Before them, on x86, it sets up the floating point unit as C99 (Annex F)
+   and every POSIX x86 system start a program: 9front's kernel gives a process
+   x87 control word 0x0232 and (amd64) MXCSR 0x1900 -- invalid operation,
+   division by zero and overflow trap (a note, "sys: fp: ..."), and the
+   x87 rounds to 53 bits, so long double is only double.  Here 0x037f:
+   all exceptions masked, 64-bit precision, round to nearest; MXCSR
+   0x1f80 on amd64 (the 386 kernel masks SSE's already, and a Pentium
+   has no MXCSR).  Programs linked -nostdlib (native Plan 9 C) keep the
+   kernel's.  RISC-V's floating point never traps, and the kernel starts
+   a program with fcsr 0 (round to nearest, no flags): nothing to do.  */
+
+typedef void (*func_ptr) (void);
+
+extern func_ptr __init_array_start[] __attribute__ ((weak));
+extern func_ptr __init_array_end[] __attribute__ ((weak));
+
+extern int __real_main (int, char **, char **);
+extern int __wrap_main (int, char **, char **);
+
+/* APE's pthreads (libap.a, sys/src/ape/lib/ap/gnu/pthread.c), when
+   linked, or Rust's std: runs main on a stack of shared memory, as the
+   other threads' stacks (a proc's stack segment is its own).  */
+extern int __plan9_mainstack (int (*) (int, char **, char **), int,
+			      char **, char **) __attribute__ ((weak));
+
+int
+__wrap_main (int argc, char **argv, char **envp)
+{
+  func_ptr *p;
+#if defined (__i386__) || defined (__x86_64__)
+  unsigned short cw = 0x037f;
+
+  __asm__ __volatile__ ("fldcw %0" : : "m" (cw));
+#ifdef __x86_64__
+  {
+    unsigned int csr = 0x1f80;
+
+    __asm__ __volatile__ ("ldmxcsr %0" : : "m" (csr));
+  }
+#endif
+#endif
+  for (p = __init_array_start; p < __init_array_end; p++)
+    (*p) ();
+  if (__plan9_mainstack)
+    return __plan9_mainstack (__real_main, argc, argv, envp);
+  return __real_main (argc, argv, envp);
+}
